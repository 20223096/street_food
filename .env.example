# 프로젝트 URL만 (끝에 /rest/v1 붙이지 말 것)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Next.js (Vercel 웹): 브라우저에서 Supabase 조회 시 필요. Flutter .env와 동일 값이면 됩니다.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# 카카오맵(WebView JS API): JavaScript 키. 네이티브 앱 키와 다릅니다.
KAKAO_NATIVE_APP_KEY=your_javascript_key
# WebView 문서 출처(baseUrl). 카카오 콘솔 → 앱 → 플랫폼 → 웹에 **여기 적은 값과 동일한** 사이트 URL을 반드시 등록해야 지도가 뜹니다.
# 비우면 기본값 http://localhost 를 쓰므로, 웹 플랫폼에 http://localhost 를 추가하세요.
# 예: KAKAO_MAP_BASE_URL=https://127.0.0.1  → 웹 플랫폼에 https://127.0.0.1 등록
# KAKAO_MAP_BASE_URL=http://localhost
